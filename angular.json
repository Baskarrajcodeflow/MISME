{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": "25b88683-caf8-4bc2-a219-a033f27dec3b"
  },
  "newProjectRoot": "projects",
  "projects": {
    "frontend": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "sourceMap": false,
            "outputPath": "dist/frontend",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "baseHref": "/web/",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              "src/favicon.ico",
              "src/assets",
              {
                "glob": "*/",
                "input": "src/assets/Fonts/",
                "output": "/assets/Fonts/"
              },
              {
                "glob": "**/*",
                "input": "node_modules/ngx-extended-pdf-viewer/assets/",
                "output": "/assets/"
              }
            ],
            "styles": [
              "@angular/material/prebuilt-themes/indigo-pink.css",
              "src/styles.css",
              "node_modules/@fortawesome/fontawesome-free/css/all.min.css",
             "node_modules/@angular/material/prebuilt-themes/deeppurple-amber.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "1mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kb",
                  "maximumError": "4kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "extractLicenses": false,
              "sourceMap": true
            },
            "manufacturer-prod": {
              "index": {
                "input": "src/index.manufacturer.html",
                "output": "index.html"
              },
              "styles": [
                "@angular/material/prebuilt-themes/indigo-pink.css",
                "src/styles.css",
                "node_modules/@fortawesome/fontawesome-free/css/all.min.css",
                "node_modules/@angular/material/prebuilt-themes/deeppurple-amber.css",
                "src/themes/manufacturer.css"
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                },
                {
                  "replace": "src/environments/platform.ts",
                  "with": "src/environments/platform.manufacturer.ts"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "1mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kb",
                  "maximumError": "4kb"
                }
              ],
              "outputHashing": "all"
            },
            "manufacturer-dev": {
              "index": {
                "input": "src/index.manufacturer.html",
                "output": "index.html"
              },
              "styles": [
                "@angular/material/prebuilt-themes/indigo-pink.css",
                "src/styles.css",
                "node_modules/@fortawesome/fontawesome-free/css/all.min.css",
                "node_modules/@angular/material/prebuilt-themes/deeppurple-amber.css",
                "src/themes/manufacturer.css"
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/platform.ts",
                  "with": "src/environments/platform.manufacturer.ts"
                }
              ],
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
          },
          "configurations": {
            "production": {
              "buildTarget": "frontend:build:production"
            },
            "development": {
              "buildTarget": "frontend:build:development",
             "proxyConfig": "src/proxy.conf.json"

            },
            "manufacturer-prod": {
              "buildTarget": "frontend:build:manufacturer-prod"
            },
            "manufacturer-dev": {
              "buildTarget": "frontend:build:manufacturer-dev",
              "proxyConfig": "src/proxy.conf.json"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "frontend:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "tsconfig.spec.json",
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],
            "styles": [
              "@angular/material/prebuilt-themes/indigo-pink.css",
              "src/styles.css",
              "node_modules/@fortawesome/fontawesome-free/css/all.min.css"
            ],
            "scripts": []
          }
        }
      }
    }
  }
}
